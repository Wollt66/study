{
  "name": "task-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "个人任务完成情况跟踪系统 - 微服务架构",
  "workspaces": [
    "shared",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "dev:user": "npm run dev -w user-service",
    "dev:task": "npm run dev -w task-service",
    "dev:tracking": "npm run dev -w tracking-service",
    "dev:report": "npm run dev -w report-service"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}

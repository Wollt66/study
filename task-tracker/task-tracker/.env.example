# ===== 全局密钥（所有服务必须一致）=====
JWT_SECRET=change-me-to-a-strong-random-secret-in-production
INTERNAL_TOKEN=change-me-to-a-strong-random-internal-token

# ===== 日志 =====
LOG_LEVEL=info

# ===== HTTP 客户端超时与重试 =====
HTTP_TIMEOUT_MS=3000
HTTP_RETRIES=1

# ===== user-service =====
USER_PORT=3001
USER_DB_PATH=./data/user.sqlite

# ===== task-service =====
TASK_PORT=3002
TASK_DB_PATH=./data/task.sqlite
TRACKING_SERVICE_URL=http://localhost:3003/api

# ===== tracking-service =====
TRACKING_PORT=3003
TRACKING_DB_PATH=./data/tracking.sqlite
TASK_SERVICE_URL=http://localhost:3002/api

# ===== report-service =====
REPORT_PORT=3004
# 下游服务地址（docker-compose 内用服务名）
# TRACKING_SERVICE_URL=http://tracking-service:3003/api
# TASK_SERVICE_URL=http://task-service:3002/api

# ---------------------------------------------------------------------------
# 后端环境变量示例（复制为 .env 后填写；.env 为本地私有文件，禁止提交）
#   cp .env.example .env
# ---------------------------------------------------------------------------

# 服务端口（默认 3001），与前端 Vite proxy 的 /api 目标保持一致
PORT=3001

# 允许跨域的前端来源，多个用英文逗号分隔；开发期默认 Vite 端口
CORS_ORIGIN=http://localhost:5173

# ------------------------------- MySQL -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 无口令实例请显式写 DB_PASSWORD=（保留变量名，值为空）
DB_PASSWORD=
DB_NAME=traffic_screen
DB_POOL_SIZE=10

# ------------------------------ 鉴权配置 -----------------------------------
# 必填，长度 >= 32；生成方式：
#   node -e "import('node:crypto').then(c=>console.log(c.randomBytes(32).toString('hex')))"
JWT_SECRET=
JWT_ISSUER=traffic-screen
# Access Token 有效期（秒），默认 7200（2 小时）
ACCESS_TOKEN_TTL=7200
# Refresh Token 有效期（秒），默认 604800（7 天）
REFRESH_TOKEN_TTL=604800

# ------------------------------ 采集器配置 ---------------------------------
# tick 周期（毫秒），与 SSE 推送同频
COLLECT_INTERVAL_MS=5000
# 模拟引擎随机种子（与前端 ENGINE_CONFIG.seed 对齐）
SIM_SEED=20260501

# --------------------------- 管理员初始化种子 ------------------------------
# 仅供 scripts/init-db.mjs 首次建号使用；首次启动用 ADMIN_INIT_PASSWORD 登录，
# 正式环境必须覆盖该环境变量（或初始化后立即修改口令），禁止沿用演示口令。
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=